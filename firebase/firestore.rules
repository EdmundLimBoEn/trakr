rules_version = '2';

// ===============================================================
// Assumed data model
// ===============================================================
// users/{uid}: uid, email, displayName, role, emailDomain, active,
//   createdAt, updatedAt, lastLoginAt. Contains PII; owner-readable.
// users/{uid}/devices/{installationId}: installationId, platform,
//   fcmToken, notificationsEnabled, updatedAt. Contains a private token.
// equipment/{id}: inventory identity, serial, active tag, status, audit fields.
// claims/{id}: checkout/return state, student UID/email, condition, timestamps.
// issues/{id}: claim/equipment/student references, text, state, timestamps.
// auditEvents/{id}: trusted immutable workflow audit records.
// All client writes are intentionally denied. Trusted callable functions use
// the Admin SDK and validate each write before it reaches Firestore.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged(uid) {
      return isAuthenticated() && request.resource.data.uid == uid;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data) {
      return data.keys().hasOnly([
          "uid", "email", "displayName", "role", "emailDomain", "active",
          "createdAt", "updatedAt", "lastLoginAt"
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ["student", "teacher"]
        && data.emailDomain is string && data.emailDomain.size() <= 253
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function role() {
      return isAuthenticated() ? request.auth.token.role : null;
    }

    function isTeacher() {
      return role() == "teacher";
    }

    function isStudent() {
      return role() == "student";
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /equipment/{equipmentId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /tags/{tagId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /claims/{claimId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.reportedByStudentUid == request.auth.uid);
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
