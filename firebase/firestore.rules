rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isTeacher() {
      return role() == "teacher";
    }

    function isStudent() {
      return role() == "student";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /equipment/{equipmentId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /tags/{tagId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /claims/{claimId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow write: if false;
    }

    match /issues/{issueId} {
      allow read: if isTeacher()
        || (isStudent() && resource.data.reportedByStudentUid == request.auth.uid);
      allow write: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if isTeacher();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

