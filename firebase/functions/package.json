{
  "name": "trakr-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "bun test test/domain.test.ts",
    "test:rules": "bun test test/firestore.rules.test.ts",
    "test:rules:emulator": "cd ../.. && firebase emulators:exec --only firestore --project trakr-test 'bun run --cwd firebase/functions test:rules'",
    "verify": "bun run test:rules:emulator",
    "serve": "cd ../.. && firebase emulators:start --only auth,firestore",
    "deploy": "cd ../.. && firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.10.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.23.0",
    "typescript": "5.9.3"
  }
}
